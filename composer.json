{
    "name": "skarjoss/laravel-keycloak-web-guard",
    "description": "Simple Keycloak Guard to Laravel Web Routes",
    "homepage": "https://github.com/Vizir/laravel-keycloak-web-guard",
    "license": "MIT",
    "keywords": [
        "laravel",
        "keycloak",
        "jwt",
        "authentication"
    ],
    "authors": [
        {
            "name": "Mário Valney",
            "email": "mariovalney@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "guzzlehttp/guzzle": "^6.5|^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/config": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "illuminate/container": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.6 || ^10.5",
        "psr/log": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Vizir\\KeycloakWebGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vizir\\KeycloakWebGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vizir\\KeycloakWebGuard\\KeycloakWebGuardServiceProvider"
            ],
            "aliases": {
                "KeycloakWeb": "Vizir\\KeycloakWebGuard\\Facades\\KeycloakWeb"
            }
        }
    }
}
